# Copy to .env and change the password. .env is gitignored and never leaves this machine.
#
# These values feed two consumers: docker-compose.yml, which initialises the Postgres container,
# and scripts/dev-server.sh, which builds the server's connection string from them. Change a value
# here and both follow — there is no second copy to keep in sync.
#
# Changing POSTGRES_PASSWORD after the first start has no effect: the image applies credentials
# only while initialising an empty data directory. To actually change it, `docker compose down -v`
# first, which destroys the local data.

POSTGRES_USER=vtt
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=vtt

# Deliberately not 5432: a Postgres installed on the host, or another project's container, would
# otherwise collide with this one.
POSTGRES_HOST_PORT=55432
